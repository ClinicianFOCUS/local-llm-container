FROM ollama/ollama:latest

# Create a dedicated non-root user and group with arbitrary IDs
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# Prepare model directory and give it to the new user
RUN mkdir -p /.ollama && chown -R appuser:appgroup /.ollama

# Ensure both model dir and the user's ~/.ollama exist and are writable
RUN mkdir -p /.ollama /home/appuser/.ollama \
 && chown -R appuser:appgroup /.ollama /home/appuser/.ollama

# Copy entrypoint script
COPY ./ollama-entrypoint.sh ollama-entrypoint.sh
